  m_Script: {fileID: 11500000, guid: c62b495ef9243d944895c3c92ecaca87, type: 3}
  m_Name: Intro Dialouge
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  dialogueId: 
  lines:
  - speakerName: Villager
    portrait: {fileID: 21300000, guid: 36207f21fa7dd604ebff80e36683bd75, type: 3}
    text: Odins hairy ballsack, you're alive! The town has been raided by Draugr,
      few survive. You are the Jarl now!
  - speakerName: Villager
    portrait: {fileID: 21300000, guid: 36207f21fa7dd604ebff80e36683bd75, type: 3}
    text: Don't worry, I will give you help along the way. Just follow my advice
      and the village will be back to normal in no time.
  - speakerName: Villager
    portrait: {fileID: 21300000, guid: 36207f21fa7dd604ebff80e36683bd75, type: 3}
    text: First thing grab yourself a weapon and finish off these remaining Draugr!
      Fight like Thor and make your ancestors proud!
  offersQuest: 0
