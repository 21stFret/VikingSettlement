  m_Script: {fileID: 11500000, guid: c62b495ef9243d944895c3c92ecaca87, type: 3}
  m_Name: MakeShieldRec
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  dialogueId: 3
  lines:
  - speakerName: Villager
    portrait: {fileID: 21300000, guid: 9df89f95df21769408e089e157cc5b2e, type: 3}
    text: Great! Take my sheild with you as well! Now you are ready to go raiding
      and earn some real loot!
  - speakerName: Villager
    portrait: {fileID: 21300000, guid: 9df89f95df21769408e089e157cc5b2e, type: 3}
    text: Go to your ship and select your vikings! Remember, if you take them out
      of thier job then production will be affected.
  - speakerName: Villager
    portrait: {fileID: 21300000, guid: 9df89f95df21769408e089e157cc5b2e, type: 3}
    text: For more information check your notifcations. Now good luck and go crack
      some skulls! For Odin!
  offersQuest: 1
